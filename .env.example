# Robíci — AI API klíče
# Zkopíruj do .env.local a doplň skutečné hodnoty (.env.local je v .gitignore).

# Ollama Cloud chat API — používá src/lib/ollama.ts + src/app/api/roboctina/chat/route.ts
OLLAMA_API_KEY=

# OpenRouter API — používá src/app/api/generate-image/route.ts (generování omalovánek)
OPENROUTER_API_KEY=
